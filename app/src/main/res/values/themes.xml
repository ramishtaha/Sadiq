<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sadiq" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- The question: no splash animation, no window chrome, page background from the first frame
         so the pause never flashes white over a dark app. -->
    <style name="Theme.Sadiq.Intercept" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page_dark</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSplashScreenBackground">@color/page_dark</item>
    </style>
</resources>
